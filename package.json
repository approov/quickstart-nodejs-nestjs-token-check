{
  "name": "approov-nestjs-token-check",
  "version": "1.0.0",
  "description": "Approov token verification and token binding quickstart using NestJS.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node --project tsconfig.json ApproovApplication.ts",
    "start:dev": "node --watch -r ts-node/register ApproovApplication.ts",
    "start:debug": "node --inspect -r ts-node/register ApproovApplication.ts",
    "start:prod": "node dist/ApproovApplication.js",
    "test": "echo 'No tests specified' && exit 0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.12",
    "@nestjs/core": "11.1.12",
    "@nestjs/platform-express": "11.1.12",
    "dotenv": "17.2.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.12",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.1.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.2",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  }
}
